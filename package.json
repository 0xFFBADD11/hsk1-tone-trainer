{
  "name": "hsk1-tone-trainer",
  "version": "1.0.0",
  "description": "Browser-based HSK 1 Mandarin vocabulary trainer with pronunciation, pinyin, and microphone tone scoring.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "fuzz": "jazzer fuzz/tone.fuzz.mjs --sync -- -runs=20000 && jazzer fuzz/pitch.fuzz.mjs --sync -- -runs=20000",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "eslint": "^10.11.0",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": ">=2.11.0 <3",
      "brace-expansion": ">=5.0.12 <6",
      "browserslist": ">=4.28.7 <5",
      "js-yaml": ">=4.3.2 <5",
      "tar": ">=7.5.21 <8",
      "undici": ">=7.30.0 <8"
    }
  }
}
